# SQLite by default - no external database needed.
# Render's free-tier disk is ephemeral (data resets on redeploy). For
# persistence, attach a Render Disk mounted at /data and set:
# DATABASE_URL=sqlite:////data/projectmentor.db
DATABASE_URL=sqlite:///./projectmentor.db

JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Optional: set to enable live chatbot answers via the Anthropic API.
# Leave blank to use the built-in placeholder responses.
LLM_API_KEY=
LLM_API_URL=https://api.anthropic.com/v1/messages
